# Express server port
PORT=3001

# Supabase project URL â€” found in your Supabase dashboard under Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key â€” keep this secret, never expose to the browser
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# API Ninjas key for species facts enrichment
API_NINJAS_API_KEY=your_api_ninjas_key_here

# Pexels API key for species photo enrichment
PEXELS_API_KEY=your_pexels_key_here

# Set to true to enable Swagger UI at /docs (dev only â€” do not enable in production)
ENABLE_SWAGGER_DOCS=true
