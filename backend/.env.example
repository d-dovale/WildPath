# Express server port
PORT=3001

# Supabase project URL — found in your Supabase dashboard under Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key — keep this secret, never expose to the browser
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Allowed frontend origin for CORS. Use the exact site origin with no trailing slash.
# Example production value: https://wild-path-frontend-navy.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Set to true to enable Swagger UI at /docs (dev only — do not enable in production)
ENABLE_SWAGGER_DOCS=true
